# Archivo .gitignore para un backend con Node.js

# Dependencias de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Archivos de entorno
.env
.env.local
.env.development
.env.test
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Directorios de desarrollo
dist/
build/
coverage/

# Archivos de configuración de IDEs y editores
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archivos de sistema
.DS_Store
Thumbs.db

# Archivos de caché
.cache/

# Archivos de pruebas
*.junit
*.xml

# Archivos de Docker
docker-compose.yml
Dockerfile
.dockerignore

# Archivos de configuración de CI/CD
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Otros
*.tmp
*.bak
*.patch